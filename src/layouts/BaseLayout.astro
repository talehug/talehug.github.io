---
import '@fontsource-variable/fredoka';
import '@fontsource-variable/nunito';
import '../styles/global.css';
import { Image } from 'astro:assets';
import wordmark from '../assets/brand/talehug-wordmark.png';
import { site } from '../data/site';

interface Props { title?: string; description?: string; noindex?: boolean }
const { title = `${site.name}: bedtime stories in the voice they love`, description = site.shortDescription, noindex = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = new URL(`${base}/og-default.png`, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fef8ef" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}/og-default.png`} type="image/png" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={og} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="header">
      <div class="wrap">
        <a class="brand" href={`${base}/`} aria-label="TaleHUG home"><Image src={wordmark} alt="taleHUG" width={180} loading="eager" /></a>
        <nav class="nav" aria-label="Main">
          <a href={`${base}/#how`}>How it works</a>
          <a href={`${base}/#voice`}>Family voice</a>
          <a href={`${base}/#safe`}>Safe for kids</a>
          <a href={`${base}/#plans`}>Plans</a>
          <a href={`${base}/#faq`}>FAQ</a>
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <slot name="footer" />
    <script>
      const els = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { threshold: 0.12 });
        els.forEach((el) => io.observe(el));
      } else els.forEach((el) => el.classList.add('in'));
    </script>
  </body>
</html>
